# Backend configuration. Copy to backend/.env (never commit it). None of these values belong in the frontend.
NEXUS_ENV=development                 # development | production (production enforces a strong SECRET_KEY and disables the demo-seed --force)
# SQLite for quick local runs; PostgreSQL for deployment, e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./nexus_dev.db
# Signs login tokens. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=480
# Comma-separated browser origins allowed to call the API (your Vercel URL, local Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BCRYPT_ROUNDS=12
# Used only by `python -m app.cli seed-demo` / `create-admin` so no password is ever hard-coded. Leave empty to be prompted or to get a random one printed once.
DEMO_PASSWORD=
ADMIN_PASSWORD=
